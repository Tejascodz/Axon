# Copy to deploy/.env and edit. Keys and passwords do NOT go here: run deploy/make-secrets.sh.

# LLM server (start one with --profile sglang or --profile vllm). The versions below are the ones
# measured on a T4 in round 5 (SGLang 0.5.23, vLLM 0.33.0); CI checks that both tags exist.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.23
VLLM_IMAGE=vllm/vllm-openai:v0.33.0
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507       # or a local path mounted into hf-cache, e.g. the merged LoRA model
LLM_SERVED_NAME=axon-llm
LLM_DTYPE=half                              # T4 has no bf16; use bfloat16 on A100/H100/L4
LLM_MAX_LEN=4096
LLM_MAX_SEQS=32
HF_TOKEN=                                   # only for gated models

# Axon
AXON_TAG=1.0
AXON_MODEL=lightonai/LateOn
AXON_MODEL_REVISION=62911e105059585d244384c7d17826e35f669c17   # the LateOn commit measured in round 5; an index records it
AXON_INDEX_DIR=./index                      # relative to deploy/; build it with `python -m nyaya.rag build`
AXON_PORT=8080
AXON_RATE_PER_MIN=120
AXON_MAX_INFLIGHT=16                        # about the LLM server's --max-running-requests / 2
AXON_MEM_LIMIT=8g                           # vectors are ~ chunks x 200 tokens x 128 x 2 bytes, plus the models
AXON_INJECTION_DETECTOR=classifier          # withhold passages a prompt-injection classifier flags (round 10: attacks 4.5% -> 0.5%,
                                            # 1.1% of clean passages withheld); "llm" asks the LLM instead (+2.5 s); empty = patterns only
AXON_INJECTION_REVISION=90c9989b1a342275dd0d1a95aad283c04e075671   # the classifier commit measured in round 10
AXON_FOLLOW_UPS=0                           # 2 = up to two LLM-written follow-up searches: MuSiQue all-supporting@10 0.42 -> 0.53,
                                            # about twice the latency
AXON_EXPAND=                                # replace = search with the LLM's reasoning about the question: BRIGHT nDCG@10 0.18 -> 0.26;
                                            # one extra LLM call; not measured on short factual questions

# Monitoring
PROMETHEUS_IMAGE=prom/prometheus:v3.4.1
GRAFANA_IMAGE=grafana/grafana:12.0.2
PROM_PORT=9090
PROM_RETENTION=15d
GRAFANA_PORT=3000
